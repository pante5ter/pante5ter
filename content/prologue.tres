[gd_resource type="Resource" script_class="DialogueDef" format=3]

[ext_resource type="Script" path="res://content/defs/dialogue_def.gd" id="1_dialogue"]
[ext_resource type="Script" path="res://content/defs/dialogue_line_def.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line_1"]
script = ExtResource("2_line")
speaker = ""
text = "Ночь. Дождь. Крыльцо Эшкомб-холла."

[sub_resource type="Resource" id="Resource_line_2"]
script = ExtResource("2_line")
speaker = "Лорд Эшкомб"
text = "Мистер Кэллоуэй. Банк хочет мой дом к весне. А вы, говорят, хотите мою землю."

[sub_resource type="Resource" id="Resource_line_3"]
script = ExtResource("2_line")
speaker = "Джек"
text = "Арендовать, милорд, а не купить. Мне нужно только поле — восточное, на десять лет, плата вперёд. Дом остаётся вашим."

[sub_resource type="Resource" id="Resource_line_4"]
script = ExtResource("2_line")
speaker = "Лорд Эшкомб"
text = "Десять лет за пшеницу, которая не окупает даже пугало? Я не стану спрашивать зачем. Отец учил: не задавай вопросов, если ответ может стоить денег."

[sub_resource type="Resource" id="Resource_line_5"]
script = ExtResource("2_line")
speaker = "Джек"
text = "Мудрый был человек. И в поле не ходите, милорд: там сыро, а у вас колени."

[sub_resource type="Resource" id="Resource_line_6"]
script = ExtResource("2_line")
speaker = "Лорд Эшкомб"
text = "Колени, да. Что ж, по рукам. Дом спасён, поле ваше — и, видит бог, я ничего не хочу о нём знать."

[sub_resource type="Resource" id="Resource_line_7"]
script = ExtResource("2_line")
speaker = "Финн"
text = "Наш контейнер стоит на краю того поля так давно, что его никто не замечает. Знают о нём только наши люди, и лорду незачем знать, что под его пшеницей. Стеллаж отодвигается, за ним лифт. Начнём, мистер Кэллоуэй."

[resource]
script = ExtResource("1_dialogue")
lines = Array[ExtResource("2_line")]([SubResource("Resource_line_1"), SubResource("Resource_line_2"), SubResource("Resource_line_3"), SubResource("Resource_line_4"), SubResource("Resource_line_5"), SubResource("Resource_line_6"), SubResource("Resource_line_7")])
