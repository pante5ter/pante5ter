[sub_resource type="Resource" id="Resource_milestone_1"]
script = ExtResource("14_milestone_def")
value = 3000
title = "Своё дело"
description = "Лорд готов сдать ещё кусок поля: до 9 грядок."
plot_cap = 9

[sub_resource type="Resource" id="Resource_milestone_2"]
script = ExtResource("14_milestone_def")
value = 7000
title = "Серьёзный человек"
description = "Голландские поставщики продают «Элитный» сорт. Грядок до 12."
plot_cap = 12
unlock_strain_id = "elite"

[sub_resource type="Resource" id="Resource_milestone_3"]
script = ExtResource("14_milestone_def")
value = 20000
title = "Членство в клубе"
description = "Старейший лондонский клуб присылает приглашение. Джек своего добился."
plot_cap = 12

[resource]
script = ExtResource("1_balance")
real_seconds_per_game_day = 600.0
starting_money = 500
plot_count = 6
strain = ExtResource("2_strain")
extra_strains = Array[ExtResource("7_strain_def")]([ExtResource("4_classic"), ExtResource("5_elite")])
worker = ExtResource("3_worker")
worker_candidates = Array[ExtResource("8_worker_def")]([ExtResource("3_worker"), ExtResource("9_dave"), ExtResource("10_barry")])
courier_candidates = Array[ExtResource("15_courier_def")]([ExtResource("16_harry"), ExtResource("17_frank"), ExtResource("18_pete")])
helper = ExtResource("20_reggie")
skills = Array[ExtResource("22_skill_def")]([ExtResource("26_pack"), ExtResource("27_driving"), ExtResource("31_electrics")])
packer_candidates = Array[ExtResource("8_worker_def")]([ExtResource("21_gladys")])
max_couriers = 2
orders = ExtResource("6_orders")
problems = ExtResource("11_problems")
suspicion = ExtResource("12_suspicion")
raids = ExtResource("13_raids")
rent = ExtResource("19_rent")
milestones = Array[ExtResource("14_milestone_def")]([SubResource("Resource_milestone_1"), SubResource("Resource_milestone_2"), SubResource("Resource_milestone_3")])
first_day = ExtResource("28_first_day")
director = ExtResource("29_director")
intrigue = ExtResource("30_intrigue")
courier_theft_story = ExtResource("32_courier_theft")
climate = ExtResource("33_climate")
day = ExtResource("34_day")
stash = ExtResource("35_stash")
fertilizer_price = 15
fertilizer_bonus = 12
prune_bonus = 8
delivery_hours = 1.5
plot_price = 400
starting_plot_cap = 8
max_plots = 12
restock_basket = Dictionary[String, int]({
"fertilizer": 4,
"lamp": 1,
"pesticide": 1,
"seed:classic": 3
})
auto_reorder_check_hours = 1.0
helper_lights_out_hours = 0.5
retired_skills = Dictionary[String, int]({
"care": 200,
"fertilize": 300,
"prune": 300
})
