[gd_resource type="Resource" script_class="CharacterDef" format=3]

[ext_resource type="Script" path="res://content/defs/character_def.gd" id="1_character"]

[resource]
script = ExtResource("1_character")
id = "gaffer"
display_name = "Гаффер"
bio = "Бывший боксёр из Глазго, держит зал в Южном Лондоне и тренирует «Молочных зубов». Говорит хрипло и быстро. На налёты не ходит; когда Вес Джека велик, приходит извиняться один — мокрое пальто, кепка в руках: «Мои пацаны дурные, но я — нет». За деньги может назвать наводчика."
