[gd_resource type="Resource" script_class="CharacterDef" format=3]

[ext_resource type="Script" path="res://content/defs/character_def.gd" id="1_character"]

[resource]
script = ExtResource("1_character")
id = "jack"
display_name = "Джек Кэллоуэй"
bio = "Австралиец: чужак и по стране, и по классу. Шахтёрский городок в Квинсленде, спортивная стипендия в Кембридже — регби. На первом курсе продавал траву богатым одноклубникам. Потом их отцы умерли, наследники получили титулы вместе с долгами, и Джек предложил им аренду: «Я плачу, ваш дом не продают. Мне нужно только поле». Обаятельный и страшный, говорит спокойно и растянуто. Лорды от него зависят, но своим не считают. Цель — членство в старейшем лондонском клубе."
meeting = "none"
