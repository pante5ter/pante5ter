[gd_resource type="Resource" script_class="CharacterDef" format=3]

[ext_resource type="Script" path="res://content/defs/character_def.gd" id="1_character"]

[resource]
script = ExtResource("1_character")
id = "silk"
display_name = "Лео «Шёлк» Чан"
bio = "Двадцать шесть лет, сын ресторатора с Джеррард-стрит. Бросил экономический в LSE на последнем курсе — сказал, что учиться у людей, которые не заработали ни фунта, неэффективно. Держит в Лондоне сеть курьеров через приложения доставки. Узкий угольный костюм, круглые очки в черепаховой оправе, белые кроссовки, одна нефритовая запонка — вторую, говорит, ещё не заслужил. Говорит тихо, без акцента и без мата, словами из годового отчёта: не «украл», а «провёл аудит». Это он купил «Молочных зубов» через голову Гаффера и оплатил клип. Хочет не ящики — хочет дело Джека целиком."
