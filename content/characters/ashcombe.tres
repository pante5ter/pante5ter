[gd_resource type="Resource" script_class="CharacterDef" format=3]

[ext_resource type="Script" path="res://content/defs/character_def.gd" id="1_character"]

[resource]
script = ExtResource("1_character")
id = "ashcombe"
display_name = "Лорд Эшкомб"
bio = "Хозяин Эшкомб-холла. От отца получил титул, дом и долги; каминные часы ушли с молотка, банк хотел дом к весне. Джек снял у него восточное поле на десять лет с платой вперёд — дом спасён. Отец учил его не задавать вопросов, если ответ может стоить денег, и лорд этому верен: о поле догадывается, но знать не хочет. В поле не ходит — колени. Леди Эшкомб замечает ночные машины и носит жемчуг, который, возможно, уже копия. Его знакомство с Джеком — сам пролог."
meeting = "opening"
