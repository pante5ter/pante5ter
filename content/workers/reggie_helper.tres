[gd_resource type="Resource" script_class="WorkerDef" format=3]

[ext_resource type="Script" path="res://content/defs/worker_def.gd" id="1_worker"]

[resource]
script = ExtResource("1_worker")
id = "reggie"
display_name = "Реджи"
description = "Правая рука. Говорит мало, думает много, выручал не раз. Возит заказы, гасит свет до проверки, лечит грядки тем, что есть на складе (лампы — только после курса электрики), и не даёт гопникам разгуляться."
daily_wage = 80
role = "helper"
male = true
task_minutes = 6.0
idle_check_minutes = 5.0
water_below_hours = 1.0
competence = 0.9
loyalty = 1.0
greed = 0.0
talkativeness = 0.0
reliability = 0.8
