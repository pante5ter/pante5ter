[resource]
script = ExtResource("1_first_day")
call_after_real_seconds = 60.0
call_quantity = 1
call_min_quality = 0
call_reward = 300
call_answer_hours = 6.0
lord_hour = 19.0
trouble_hour = 30.0
lord_story = ExtResource("2_lord")
trouble_story = ExtResource("3_neighbour")
plant_field_line = "Погреб пока пустой. Спуститесь через контейнер на плантацию и посадите семена — с этого всё начинается."
plant_bunker_line = "Мы на месте. Посадите семена: кликните по пустой грядке. Дальше — вода и терпение."
call_line = "Посажено. Теперь полейте и ждите: первый звонок, как первая любовь, приходит сам. Скоро."
answer_line = "Звонит первый клиент, мистер Кэллоуэй. Возьмите трубку — телефон, Tab, «Звонки» — и соглашайтесь: платит щедро."
harvest_line = "Клиент ждёт. Как созреет — соберите урожай на плантации. И поливайте: сухой куст денег не приносит."
haul_line = "Урожай в ящиках. На ферме его не держим: кликните по ящикам в бункере — отвезу их в тайник при пекарне, или везите сами на лендровере."
pack_line = "Ящики в тайнике. Россыпью приличные люди не продают — расфасуйте товар на столе в тайнике."
send_line = "Коробка готова. На компьютере, «Заказы», отправьте меня. Вожу аккуратно и в дороге молчу."
paid_line = "Я в пути. Пока везу — посадите и полейте ещё. Деньги будут, когда вернусь."
evening_line = "Первые деньги, мистер Кэллоуэй. Сажайте, отвечайте на звонки. К вечеру, полагаю, о нас кое-кто вспомнит."
morning_line = "Ночь прошла спокойно. Пока. Держите грядки политыми и телефон под рукой — утро покажет, крепкие ли у нас нервы."
trouble_line = "Вредители. Средство от них — в телефоне, «Магазин». Есть на складе — обработаю сам, нет — закажите и заберите посылку."
