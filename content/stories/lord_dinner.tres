[gd_resource type="Resource" script_class="StoryDef" format=3]

[ext_resource type="Script" path="res://content/defs/story_def.gd" id="1_story"]
[ext_resource type="Script" path="res://content/defs/story_choice_def.gd" id="2_choice"]
[ext_resource type="Script" path="res://content/defs/dialogue_line_def.gd" id="3_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3_line")
speaker = "Лорд Эшкомб"
text = "Мистер Кэллоуэй, в субботу у меня ужин. Будут викарий, пара соседей и главный констебль графства Дэвенпорт. Леди Эшкомб настаивает, чтобы был и наш загадочный арендатор."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "Ужин с констеблем. Либо лучшая маскировка, либо худший вечер в вашей жизни."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3_line")
speaker = "Лорд Эшкомб"
text = "Дэвенпорт в восторге! Сказал, что вы «редкий в наших краях порядочный человек». Я, разумеется, согласился."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3_line")
speaker = "Лорд Эшкомб"
text = "Дэвенпорт весь вечер спрашивал, чем вы занимаетесь. Вы трижды ответили по-разному. Было… оживлённо."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "Трижды. Запишем как урок."

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Пойти и очаровать констебля"
chance = 0.6
suspicion = -10.0
relation_change = 1
fail_suspicion = 8.0
relation = "lord"
reply = Array[ExtResource("3_line")]([SubResource("Line_3")])
fail_reply = Array[ExtResource("3_line")]([SubResource("Line_4"), SubResource("Line_5")])

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3_line")
speaker = "Лорд Эшкомб"
text = "Дела, да. У всех дела. Даже у меня, представьте. Что ж, в другой раз."

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Сослаться на дела"
relation_change = -1
relation = "lord"
reply = Array[ExtResource("3_line")]([SubResource("Line_6")])

[sub_resource type="Resource" id="Call_1"]
script = ExtResource("3_line")
speaker = "Дворецкий"
text = "Мистер Кэллоуэй? Дженкинс, из Эшкомб-холла. Милорд желает пригласить вас лично. Он будет у крыльца."

[sub_resource type="Resource" id="Call_2"]
script = ExtResource("3_line")
speaker = "Джек"
text = "Передайте милорду: заеду."

[resource]
script = ExtResource("1_story")
id = "lord_dinner"
kind = "lord"
place = "manor"
caller = "Дворецкий"
call_lines = Array[ExtResource("3_line")]([SubResource("Call_1"), SubResource("Call_2")])
call_task = "Лорд зовёт в поместье"
lines = Array[ExtResource("3_line")]([SubResource("Line_1"), SubResource("Line_2")])
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
