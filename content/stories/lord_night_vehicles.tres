[gd_resource type="Resource" script_class="StoryDef" format=3]

[ext_resource type="Script" path="res://content/defs/story_def.gd" id="1_story"]
[ext_resource type="Script" path="res://content/defs/story_choice_def.gd" id="2_choice"]
[ext_resource type="Script" path="res://content/defs/dialogue_line_def.gd" id="3_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3_line")
speaker = ""
text = "Вечер. Лорд Эшкомб принимает вас в библиотеке, у камина."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3_line")
speaker = "Лорд Эшкомб"
text = "Мистер Кэллоуэй, простите, что зазвал вас так поздно. Леди Эшкомб уверяет, что ночью по нашей дороге ездят машины. Много машин. Я сказал ей, что это лисы. Она сказала, что лисы не включают фары."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3_line")
speaker = "Финн"
text = "Ответ подберите аккуратно. Лорд не хочет знать правду — он хочет повод её не знать."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3_line")
speaker = "Лорд Эшкомб"
text = "Браконьеры! Я так и знал. Отец вешал их на воротах — фигурально, разумеется. Благодарю, мистер Кэллоуэй."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3_line")
speaker = "Лорд Эшкомб"
text = "Браконьеры… на фургонах? По расписанию? Хм. Я ничего не слышал. Совсем ничего."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3_line")
speaker = "Финн"
text = "Поверил на две трети. Оставшаяся треть пойдёт гулять по деревне."

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "«Браконьеры, милорд. Гоняют ваших оленей»"
chance = 0.7
suspicion = -3.0
relation_change = 1
fail_suspicion = 6.0
fail_relation_change = -1
relation = "lord"
reply = Array[ExtResource("3_line")]([SubResource("Line_4")])
fail_reply = Array[ExtResource("3_line")]([SubResource("Line_5"), SubResource("Line_6")])

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("3_line")
speaker = "Лорд Эшкомб"
text = "Органика. Как современно. Леди Эшкомб обожает всё органическое — кроме запаха. Доброй ночи."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("3_line")
speaker = "Финн"
text = "Изящно. Немного навозно, но изящно."

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "«Удобрения, милорд. Органику возят ночью — днём запах»"
suspicion = 2.0
relation_change = 1
relation = "lord"
reply = Array[ExtResource("3_line")]([SubResource("Line_7"), SubResource("Line_8")])

[resource]
script = ExtResource("1_story")
id = "lord_night_vehicles"
kind = "script"
place = "manor"
lines = Array[ExtResource("3_line")]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
