[gd_resource type="Resource" script_class="StoryDef" format=3]

[ext_resource type="Script" path="res://content/defs/story_def.gd" id="1_story"]
[ext_resource type="Script" path="res://content/defs/story_choice_def.gd" id="2_choice"]
[ext_resource type="Script" path="res://content/defs/dialogue_line_def.gd" id="3_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3_line")
speaker = ""
text = "Звонок с незнакомого номера. Молодой бодрый голос, на фоне стучит клавиатура."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3_line")
speaker = "Репортёр"
text = "Тоби Пэлфри, «Котсуолдский вестник». Готовлю выпуск к празднику урожая. Тыквы, сидр, викарий на тракторе. Вы ведь новый арендатор у лорда Эшкомба?"

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3_line")
speaker = "Репортёр"
text = "Пара слов для рубрики «Новые лица»: что растите, будете ли выставлять тыкву. Соседи говорят, у вас трудолюбивые ребята. Допоздна работают."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "Мальчик с блокнотом. Пока что — про тыквы."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3_line")
speaker = "Репортёр"
text = "Пшеница, сено, немного овощей — чудесно. Напишу: «Новый сосед любит землю». Читатели такое обожают."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "Самая скучная заметка в истории графства. Идеально."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("3_line")
speaker = "Репортёр"
text = "Пшеница? Забавно, я проезжал мимо — она у вас какая-то… декоративная. Ладно, не моё дело. Пока."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "«Пока» — это он про заметку или про нас?"

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Поболтать про поле и праздник урожая"
chance = 0.6
suspicion = -3.0
fail_suspicion = 4.0
relation_change = 1
relation = "village"
reply = Array[ExtResource("3_line")]([SubResource("Line_5"), SubResource("Line_6")])
fail_reply = Array[ExtResource("3_line")]([SubResource("Line_7"), SubResource("Line_8")])

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("3_line")
speaker = "Репортёр"
text = "Спонсор праздничного выпуска! «Ферма Кэллоуэя поздравляет графство». Редактор растрогается. Он вообще легко растрогивается — за двести фунтов."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "Кто платит за праздник, того не подозревают. По крайней мере, до праздника."

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Оплатить праздничную полосу — £200"
money = -200
suspicion = -6.0
relation_change = 1
relation = "village"
reply = Array[ExtResource("3_line")]([SubResource("Line_9"), SubResource("Line_10")])

[resource]
script = ExtResource("1_story")
id = "reporter"
kind = "village"
caller = "Репортёр"
lines = Array[ExtResource("3_line")]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4")])
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
