[gd_resource type="Resource" script_class="StoryDef" format=3]

[ext_resource type="Script" path="res://content/defs/story_def.gd" id="1_story"]
[ext_resource type="Script" path="res://content/defs/story_choice_def.gd" id="2_choice"]
[ext_resource type="Script" path="res://content/defs/dialogue_line_def.gd" id="3_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3_line")
speaker = ""
text = "Звонок с незнакомого номера. Молодой голос, на фоне стучит клавиатура."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3_line")
speaker = "Репортёр"
text = "Тоби Пэлфри, «Котсуолдский вестник». Читатели жалуются на ночные фургоны. Версий две: вы снимаете кино или прячете тело. Редактор склоняется к телу."

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "Местная газета — не Скотленд-Ярд. Хуже: её читают все."

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3_line")
speaker = "Репортёр"
text = "Экологичные вешенки для лондонских ресторанов! Это же разворот: «Тайна поля раскрыта — грибы»."

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "Скучнее заголовка не придумать. Ровно то, что нужно."

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3_line")
speaker = "Репортёр"
text = "Грибы. Которые возят по ночам фургонами. Пожалуй, напишу «Расследование продолжается»."

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "Слово «продолжается» мне не нравится."

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Дать интервью про «грибную ферму»"
chance = 0.5
suspicion = -8.0
fail_suspicion = 12.0
reply = Array[ExtResource("3_line")]([SubResource("Line_4"), SubResource("Line_5")])
fail_reply = Array[ExtResource("3_line")]([SubResource("Line_6"), SubResource("Line_7")])

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("3_line")
speaker = "Репортёр"
text = "Целую полосу? «Кэллоуэй: органические удобрения». Знаете, редактор вдруг остыл к истории с телом."

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("3_line")
speaker = "Реджи"
text = "Свобода прессы — дорогое удовольствие. Особенно её отсутствие."

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Купить рекламную полосу — £200"
money = -200
suspicion = -10.0
relation_change = 1
relation = "village"
reply = Array[ExtResource("3_line")]([SubResource("Line_8"), SubResource("Line_9")])

[resource]
script = ExtResource("1_story")
id = "reporter"
kind = "village"
lines = Array[ExtResource("3_line")]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3")])
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
